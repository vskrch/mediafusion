# Heroku deploy — rebuild Rust binaries with repo-root build context.
FROM rust:1-bookworm AS builder
WORKDIR /app
COPY backend/ backend/
COPY resources/ resources/
ENV SQLX_OFFLINE=true
RUN cd backend && cargo build --release --bin mediafusion-api --bin mediafusion-worker

FROM mhdzumair/mediafusion:6.0.0-beta.22

USER root
COPY --from=builder /app/backend/target/release/mediafusion-api /usr/local/bin/mediafusion-api
COPY --from=builder /app/backend/target/release/mediafusion-worker /usr/local/bin/mediafusion-worker
COPY deployment/heroku/start.sh /start.sh
RUN chmod +x /start.sh
USER mediafusion

CMD ["/start.sh"]
